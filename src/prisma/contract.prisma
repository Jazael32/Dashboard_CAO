// use prisma-8
model User {
  id           Int                  @id @default(autoincrement())
  email        String               @unique
  passwordHash String
  username     String?
  name         String?
  createdAt    DateTime             @default(now())
  updatedAt    temporal.updatedAt()
}

model Dataset {
  id        Uuid                 @id @onCreate(uuid())
  name      String
  columns   Jsonb
  rows      Jsonb
  createdAt DateTime             @default(now())
  updatedAt temporal.updatedAt()
}
